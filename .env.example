# Salin ke .env untuk jalan di laptop. Di GitHub, isi semua ini sebagai "Secrets" (lihat README).
GEMINI_API_KEY=          # wajib (gratis: aistudio.google.com/apikey)
GROQ_API_KEY=            # opsional, cadangan gratis (console.groq.com)
OPENROUTER_API_KEY=      # opsional, cadangan gratis (openrouter.ai)
YT_API_KEY=              # wajib untuk riset tren (Google Cloud > YouTube Data API v3 > API key)
YT_CLIENT_ID=            # wajib untuk unggah (OAuth client "Desktop app")
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=        # didapat dari: npm run auth
TELEGRAM_BOT_TOKEN=      # opsional, notifikasi ke HP
TELEGRAM_CHAT_ID=
